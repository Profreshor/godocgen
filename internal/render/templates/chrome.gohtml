{{define "head"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{.}}</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; display: flex; } 
    nav { width: 260px; flex-shrink: 0; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
    main { flex: 1; max-width: 900px; margin: 0 auto; padding: 2rem; }
    .symbol { margin: 1.5rem 0; border-left: 3px solid #ddd; padding-left: 1rem; }
    .kind { color: #666; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.05em; }
    .name { font-weight: 600; }
    .detail { background: #f6f8fa; padding: 0.6rem 1rem; border-radius: 6px; overflow-x: auto; }
    .index { background: #f6f8fa; padding: 0.6rem 1rem; border-radius: 6px; overflow-x: auto; }
    .index h4 { margin: 0.75rem 0 0.25rem; }
    .index ul.index-list { margin: 0; }
    .doc { margin-top: 0.75rem; white-space: pre-wrap; }
    .meta { color: #888; font-size: 0.8em; margin-top: 0.4rem; }
    ul.index-list { columns: 14rem; column-gap: 2rem; list-style: none; padding-left: 0; }
    ul.symbols { list-style: none; padding-left: 0; }
    ul.index-list li { overflow-wrap: break-word; }
    ul.symbols ul.symbols { padding-left: 1.5rem; }
  </style>
</head>
<body>
{{end}}

{{define "foot"}}
</body>
</html>
{{end}}

{{define "nav"}}
<nav>
  <p><a href="/">⌂ index</a></p>
  {{range .}}
    <details open>
      <summary>{{.Parent}}</summary>
      <ul>{{range .Items}}<li><a href="/pkg/{{.Slug}}">{{.Label}}</a></li>{{end}}</ul>
    </details>
  {{end}}
</nav>
{{end}}